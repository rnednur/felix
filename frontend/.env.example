# API Configuration
VITE_API_URL=/api/v1

# Google OAuth (for Google Sheets import)
# Get this from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID for Web application
# Add authorized JavaScript origin: http://localhost:5173
# Each user will authenticate with their own Google account
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Mapbox Access Token (for Talk2Map / Kepler.gl visualization)
# Get a free token at https://account.mapbox.com
# Create an account and generate a public access token
# Without this token, the map visualization will not work
VITE_MAPBOX_TOKEN=your_mapbox_token_here
