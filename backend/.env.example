DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_analytics
REDIS_URL=redis://localhost:6379/0

# Optional: Database schema name (if not set, uses 'public' schema)
# DB_SCHEMA=myapp

OPENROUTER_API_KEY=your_key_here

# LLM Models - all use OpenRouter
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free  # Default model for general queries
PRESENTATION_MODEL=google/gemini-2.0-flash-exp:free  # Model for PowerPoint generation
AGENT_MODEL=google/gemini-2.0-flash-exp:free  # Model for dashboard/analysis agents
VISION_MODEL=google/gemini-2.0-flash-exp:free  # Model for vision tasks (color extraction)
IMAGE_GEN_MODEL=google/gemini-2.0-flash-exp:free  # Model for image generation (infographics)

# Optional: LLM configuration for data scouting (defaults to OPENROUTER_MODEL)
# LLM_TEMPERATURE=0.2  # Lower = more deterministic, Higher = more creative (0.0-1.0)
# LLM_MAX_TOKENS=500   # Maximum tokens for LLM responses

ENVIRONMENT=development
